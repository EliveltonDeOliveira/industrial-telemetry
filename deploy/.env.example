# Development defaults used by docker-compose.yml.
# To override them, copy this file to deploy/.env and edit it. deploy/.env is not versioned.

POSTGRES_DB=industrial
POSTGRES_USER=industrial
POSTGRES_PASSWORD=industrial
# Read only role used by Grafana. Set before the first docker compose up: the migration creates it once.
POSTGRES_GRAFANA_PASSWORD=grafana

CLICKHOUSE_DB=industrial
CLICKHOUSE_USER=industrial
CLICKHOUSE_PASSWORD=industrial

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Simulated machines (maq-01, maq-02...) and time between readings of each one.
SIM_MACHINES=3
SIM_INTERVAL=1s

# Machines of simulator-carga (carga-01, carga-02...), 0 outside the load test (ADR 0019).
CARGA_MACHINES=0

# Shifts of etl-oee, in local hours of ETL_TIMEZONE. Hours left out are not planned time.
ETL_TIMEZONE=America/Sao_Paulo
ETL_SHIFTS=06-14,14-22,22-06
