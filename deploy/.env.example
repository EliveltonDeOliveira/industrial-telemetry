# Development defaults used by docker-compose.yml.
# To override them, copy this file to deploy/.env and edit it. deploy/.env is not versioned.

POSTGRES_DB=industrial
POSTGRES_USER=industrial
POSTGRES_PASSWORD=industrial

CLICKHOUSE_DB=industrial
CLICKHOUSE_USER=industrial
CLICKHOUSE_PASSWORD=industrial

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Simulated machines (maq-01, maq-02...) and time between readings of each one.
SIM_MACHINES=3
SIM_INTERVAL=1s
