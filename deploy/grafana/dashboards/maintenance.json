    {
      "id": 4,
      "type": "stat",
      "title": "Tempo médio até concluir",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Média de fechamento menos abertura das ordens concluídas no período. Canceladas ficam de fora.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(extract(epoch FROM closed_at - opened_at)) AS \"Tempo médio\"\nFROM work_orders\nWHERE status = 'concluida' AND $__timeFilter(closed_at) AND machine_id IN (${machine:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "nenhuma concluída"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alertas por tipo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Alertas recebidos em cada intervalo, por tipo.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval, 0), alert_type::text AS metric, count(*) AS value\nFROM alerts\nWHERE $__timeFilter(ts) AND machine_id IN (${machine:singlequote})\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temperatura_alta"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vibracao_alta"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "parada_longa"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Ordens ativas",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Ordens aberta e em_andamento, das mais antigas para as mais novas, com os alertas ligados a cada uma. Não depende do período. O número da ordem abre o detalhe na API.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.id AS \"Ordem\", o.machine_id AS \"Máquina\", o.alert_type::text AS \"Tipo\",\n  o.status::text AS \"Estado\", coalesce(o.assignee, '') AS \"Responsável\", o.opened_at AS \"Aberta em\",\n  count(a.alert_id) AS \"Alertas\", max(a.ts) AS \"Último alerta\"\nFROM work_orders o LEFT JOIN alerts a ON a.work_order_id = o.id\nWHERE o.status IN ('aberta', 'em_andamento') AND o.machine_id IN (${machine:singlequote})\nGROUP BY o.id\nORDER BY o.opened_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "noValue": "nenhuma"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ordem"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Abrir na API do maintenance",
                    "url": "http://localhost:8082/work-orders/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "aberta": {
                        "color": "orange",
                        "index": 0
                      },
                      "em_andamento": {
                        "color": "blue",
                        "index": 1
                      },
                      "concluida": {
                        "color": "green",
                        "index": 2
                      },
                      "cancelada": {
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "temperatura_alta": {
                        "color": "red",
                        "index": 0
                      },
                      "vibracao_alta": {
                        "color": "orange",
                        "index": 1
                      },
                      "parada_longa": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
