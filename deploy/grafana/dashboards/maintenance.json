{
  "uid": "maintenance",
  "title": "Manutenção",
  "description": "Alertas do anomaly e ordens de manutenção do mini CMMS, lidos do PostgreSQL com o papel só de leitura grafana. Atualiza a cada 10 segundos.",
  "tags": [
    "manutencao",
    "alertas"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "OEE por máquina",
      "type": "link",
      "url": "/d/oee",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
