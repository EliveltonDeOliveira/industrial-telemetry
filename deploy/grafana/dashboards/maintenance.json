      "title": "Ordens fechadas no período",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Ordens concluídas ou canceladas no período, pela hora do fechamento, das mais recentes para as mais antigas.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.id AS \"Ordem\", o.machine_id AS \"Máquina\", o.alert_type::text AS \"Tipo\",\n  o.status::text AS \"Estado\", coalesce(o.assignee, '') AS \"Responsável\", o.closed_at AS \"Fechada em\",\n  extract(epoch FROM o.closed_at - o.opened_at) AS \"Duração\"\nFROM work_orders o\nWHERE o.status IN ('concluida', 'cancelada') AND $__timeFilter(o.closed_at) AND o.machine_id IN (${machine:singlequote})\nORDER BY o.closed_at DESC\nLIMIT 200"
        }
