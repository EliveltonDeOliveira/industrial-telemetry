      "type": "table",
      "title": "Alertas no período",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Os 200 alertas mais recentes do período. Valor e limite usam a unidade do tipo: °C, g ou segundos parada.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Quando\", machine_id AS \"Máquina\", alert_type::text AS \"Tipo\",\n  severity::text AS \"Severidade\", value AS \"Valor\", threshold AS \"Limite\", work_order_id AS \"Ordem\"\nFROM alerts\nWHERE $__timeFilter(ts) AND machine_id IN (${machine:singlequote})\nORDER BY ts DESC\nLIMIT 200"
        }
