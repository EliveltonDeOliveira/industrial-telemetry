      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Alertas recebidos do anomaly, pelo ts da leitura que disparou cada um.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Alertas\" FROM alerts WHERE $__timeFilter(ts) AND machine_id IN (${machine:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
