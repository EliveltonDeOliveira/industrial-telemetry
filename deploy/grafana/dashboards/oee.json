{
  "uid": "oee",
  "title": "OEE por máquina",
  "description": "OEE, estado, temperatura e vibração de cada máquina. Atualiza a cada 10 segundos.",
  "tags": [
    "oee",
    "telemetria"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "Manutenção",
      "type": "link",
      "url": "/d/maintenance",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Alertas",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, machine_id || ' ' || alert_type::text || ': ' || value || ' (limite ' || threshold || ')' AS text,\n  machine_id || ',' || alert_type::text AS tags\nFROM alerts\nWHERE $__timeFilter(ts) AND machine_id IN (${machine:singlequote})\nORDER BY ts"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "machine",
        "label": "Máquina",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "telemetry-api"
        },
        "description": "Máquinas do cadastro que já mandaram alguma leitura.",
        "query": {
          "queryType": "infinity",
          "query": "",
          "infinityQuery": {
            "refId": "variable",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "/machines",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "root_selector": "machines[last_reading != null]",
            "columns": [
              {
                "selector": "machine_id",
                "text": "machine_id",
                "type": "string"
              }
            ]
          }
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "OEE ${machine}",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "telemetry-api"
      },
      "repeat": "machine",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "description": "Calculado pela API do telemetry (GET /machines/{id}/oee) para o período do dashboard, com as regras do ADR 0009. A API recusa períodos acima de 7 dias. Vermelho abaixo de 60%, verde a partir de 85%.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "telemetry-api"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/machines/${machine}/oee",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "from",
                "value": "${__from:date:iso}"
              },
              {
                "key": "to",
                "value": "${__to:date:iso}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "oee",
              "text": "OEE",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Fatores ${machine}",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "telemetry-api"
      },
      "repeat": "machine",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "description": "OEE = disponibilidade × performance × qualidade.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "telemetry-api"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/machines/${machine}/oee",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "from",
                "value": "${__from:date:iso}"
              },
              {
                "key": "to",
                "value": "${__to:date:iso}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "availability",
              "text": "Disponibilidade",
              "type": "number"
            },
            {
              "selector": "performance",
              "text": "Performance",
              "type": "number"
            },
            {
              "selector": "quality",
              "text": "Qualidade",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peças ${machine}",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "telemetry-api"
      },
      "repeat": "machine",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "description": "Peças feitas no período, somando o quanto os contadores cresceram dentro de cada boot_id.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "telemetry-api"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/machines/${machine}/oee",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "from",
                "value": "${__from:date:iso}"
              },
              {
                "key": "to",
                "value": "${__to:date:iso}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "good",
              "text": "Boas",
              "type": "number"
            },
            {
              "selector": "scrap",
              "text": "Refugo",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical"
      }
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Estado",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "description": "Estado predominante em cada intervalo, lido direto do ClickHouse.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "interval": "1s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, machine_id, avg(state = 'running') >= 0.5 AS running\nFROM telemetry_raw\nWHERE $__timeFilter(ts) AND machine_id IN (${machine:singlequote})\nGROUP BY time, machine_id\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.machine_id}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Parada",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Rodando",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperatura",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "interval": "1s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, machine_id, avg(temperature_c) AS temperature\nFROM telemetry_raw\nWHERE $__timeFilter(ts) AND machine_id IN (${machine:singlequote})\nGROUP BY time, machine_id\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.machine_id}",
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Vibração (RMS)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "interval": "1s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, machine_id, avg(vibration_rms) AS vibration\nFROM telemetry_raw\nWHERE $__timeFilter(ts) AND machine_id IN (${machine:singlequote})\nGROUP BY time, machine_id\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.machine_id}",
          "unit": "accG",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
