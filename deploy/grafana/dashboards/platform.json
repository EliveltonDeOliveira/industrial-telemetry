    {
      "id": 13,
      "type": "timeseries",
      "title": "Falhas por minuto",
      "description": "Tentativas que falharam, por serviço e operação. São repetidas: com o banco ou o broker fora, a linha sobe e o lag cresce, sem mensagem perdida.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "60 * sum by (job, operation) (rate({__name__=~\"simulator_publish_failures_total|bridge_produce_failures_total|telemetry_failures_total|anomaly_failures_total|maintenance_failures_total\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{operation}}",
          "range": true,
          "instant": false
