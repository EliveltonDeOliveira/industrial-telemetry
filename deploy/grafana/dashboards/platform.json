        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requisições HTTP por rota",
      "description": "Requisições por segundo nas APIs dos serviços Go, sem /metrics e /healthz. As do telemetry vêm em boa parte do dashboard de OEE aberto.",
      "datasource": {
        "type": "prometheus",
