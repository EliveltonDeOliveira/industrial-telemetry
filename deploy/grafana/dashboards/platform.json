    {
      "id": 9,
      "type": "timeseries",
      "title": "Mensagens por etapa",
      "description": "Leituras por segundo em cada etapa. Com o pipeline em dia, as linhas se sobrepõem. Uma etapa abaixo da anterior está acumulando lag ou perdendo mensagens. O simulator não conta as leituras do gateway.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(simulator_messages_published_total[$__rate_interval]))",
          "legendFormat": "simulator publicou no MQTT",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(bridge_messages_produced_total{topic=\"telemetria.bruta\"}[$__rate_interval]))",
          "legendFormat": "bridge gravou no Kafka",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(telemetry_rows_inserted_total[$__rate_interval]))",
          "legendFormat": "telemetry gravou no ClickHouse",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(anomaly_records_consumed_total[$__rate_interval]))",
          "legendFormat": "anomaly consumiu",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Mensagens por tópico",
      "description": "Mensagens gravadas por segundo em cada tópico do Kafka, pelo fim das partições lido pelo kafka-lag.",
